{
  "expo": {
    "name": "SecureShare",
    "slug": "secureshare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.secureshare.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "SecureShare uses biometrics to protect your encrypted vaults.",
        "UIBackgroundModes": ["fetch"]
      }
    },
    "android": {
      "package": "com.secureshare.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0f19"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SecureShare to use Face ID to authenticate."
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow SecureShare to access the hardware keychain."
        }
      ]
    ]
  }
}
