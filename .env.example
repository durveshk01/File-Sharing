APP_SECRET=replace-with-a-long-random-secret
# Generate with: python -c "import base64,secrets;print(base64.b64encode(secrets.token_bytes(32)).decode())"
KEK_BASE64=replace-with-base64-encoded-32-random-bytes
DATABASE_URL=sqlite:///./data/secureshare.db
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://secureshare:secureshare_dev_password@localhost:5432/secureshare
STORAGE_PATH=./storage
STORAGE_BACKEND=local
# For production S3-compatible storage (AWS S3, MinIO, Cloudflare R2):
# STORAGE_BACKEND=s3
# S3_BUCKET_NAME=secureshare-bucket
# S3_ENDPOINT_URL=http://localhost:9000
# S3_REGION_NAME=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadminpassword
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
COOKIE_SECURE=false
SESSION_DAYS=7
MAX_UPLOAD_BYTES=52428800
RUN_MIGRATIONS_ON_START=true
DEMO_LOGIN_ENABLED=true
MAIL_MODE=console
# For production SMTP delivery:
# MAIL_MODE=smtp
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@example.com
# SMTP_PASSWORD=secret
MAIL_FROM=noreply@secureshare.local
POSTGRES_DB=secureshare
POSTGRES_USER=secureshare
POSTGRES_PASSWORD=replace-with-a-strong-database-password
